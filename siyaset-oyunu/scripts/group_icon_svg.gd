static var _cache: Dictionary = {}

## Simgenin beyaz dokusu (önbellekli).
static func texture(icon_name: String) -> Texture2D:
	if _cache.has(icon_name):
		return _cache[icon_name]
	if not SVGS.has(icon_name):
		return null
	var image := Image.new()
	# 0.0.253: 256 px + mipmap (her çözünürlükte keskin).
	image.load_svg_from_string(String(SVGS[icon_name]), 2.0)
	image.generate_mipmaps()
	var tex := ImageTexture.create_from_image(image)
	_cache[icon_name] = tex
	return tex

## Ekranda tam bu piksel boyunda çizilecek simge (önbellekli). Büyük dokuyu
## küçültmek kenarları yumuşatıyordu; tam boyda rasterleşen SVG her
## çözünürlükte keskin kalır (0.0.258).
static func texture_px(icon_name: String, px: int) -> Texture2D:
	px = clampi(px, 8, 512)
	var key := "%s@%d" % [icon_name, px]
	if _cache.has(key):
		return _cache[key]
	if not SVGS.has(icon_name):
		return null
	var image := Image.new()
	image.load_svg_from_string(String(SVGS[icon_name]), float(px) / 128.0)
	var tex := ImageTexture.create_from_image(image)
	_cache[key] = tex
	return tex
